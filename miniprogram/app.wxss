page {
  background: #f4efe6;
  color: #1c1914;
  font-size: 28rpx;
  line-height: 1.6;
}

.wrap { padding: 24rpx 28rpx 48rpx; }
.hero, .card, .job {
  background: #fffdf8;
  border: 1rpx solid #e6dfd2;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.kicker { color: #c4a35a; font-size: 22rpx; letter-spacing: 2rpx; }
.h2 { font-size: 36rpx; font-weight: 650; margin: 10rpx 0; }
.lede { color: #6f675c; font-size: 26rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.chip, .tag {
  border: 1rpx solid #e6dfd2;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}
.chip-on { background: #1a365d; color: #fff; border-color: #1a365d; }
.tag { background: #f3e6c4; border-color: transparent; }
.search {
  background: #fff;
  border: 1rpx solid #e6dfd2;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.job-top { display: flex; gap: 20rpx; }
.logo {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  background: #1a365d; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
}
.job-title { font-size: 30rpx; font-weight: 650; }
.meta { color: #6f675c; font-size: 24rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.salary { color: #1a365d; font-weight: 650; }
.visa { color: #2f6f4e; font-size: 24rpx; }
.empty, .err { text-align: center; color: #6f675c; padding: 80rpx 20rpx; }
.err { color: #b42318; }
.hl { padding-left: 32rpx; }
.btn {
  margin-top: 24rpx;
  background: #1a365d;
  color: #fff;
  text-align: center;
  border-radius: 16rpx;
  padding: 22rpx;
}
.btn-ghost { background: #fff; color: #1a365d; border: 1rpx solid #e6dfd2; }
.fav { border: 1rpx solid #e6dfd2; border-radius: 999rpx; padding: 8rpx 20rpx; font-size: 24rpx; }
